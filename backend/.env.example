# Copy this file to `.env` in the same folder and fill in your real key.
# Never commit the real `.env` file — it's already in .gitignore.
#
# Get a FREE key (no credit card required) from Google AI Studio:
#   1. Go to https://aistudio.google.com/apikey
#   2. Sign in with a Google account
#   3. Click "Create API key"
#   4. Paste it below

GEMINI_API_KEY=your-free-gemini-api-key-here

# Optional overrides:
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=2048
MAX_INPUT_CHARS=20000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
